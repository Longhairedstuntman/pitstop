{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "npm run lint:js && npm run lint:css && npm run lint:docs",
        "lint:js": "eslint \"resources/js/**/*.js\" --max-warnings=0",
        "lint:css": "stylelint \"resources/css/**/*.css\"",
        "lint:docs": "markdownlint-cli2 \"README.md\" \"docs/**/*.md\" \".github/**/*.md\"",
        "format": "prettier --write \"{*.md,docs/**/*.md,.github/**/*.md,resources/js/**/*.js,*.{json,yml,yaml},pitstop.code-workspace}\"",
        "format:check": "prettier --check \"{*.md,docs/**/*.md,.github/**/*.md,resources/js/**/*.js,*.{json,yml,yaml},pitstop.code-workspace}\""
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/vite": "^4.0.0",
        "alpinejs": "^3.4.2",
        "autoprefixer": "^10.4.2",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^9.1.0",
        "laravel-vite-plugin": "^2.0.0",
        "markdownlint-cli2": "^0.18.1",
        "postcss": "^8.4.31",
        "prettier": "^3.9.10",
        "prettier-plugin-blade": "^2.1.20",
        "stylelint": "^16.16.0",
        "stylelint-config-standard": "^37.0.0",
        "tailwindcss": "^3.1.0",
        "vite": "^7.0.7"
    }
}
