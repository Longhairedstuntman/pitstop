APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

OPS_NOTIFY_EMAIL=

# --- Email help desk (see HELPDESK_EMAIL.md) -------------------------------
# The public address people email to open a ticket.
HELPDESK_INBOUND_ADDRESS=
HELPDESK_FROM_NAME="MWM Help Desk"

# Secret segment in the inbound webhook URL. REQUIRED — the endpoint fails
# closed (503) without it. Generate with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
HELPDESK_INBOUND_SECRET=

# Optional basic-auth second factor; must match the provider's webhook URL.
HELPDESK_INBOUND_BASIC_USER=
HELPDESK_INBOUND_BASIC_PASSWORD=

# Where new-ticket and new-reply notifications go.
HELPDESK_OPS_NOTIFY_EMAIL=

HELPDESK_AUTO_ACK=true
HELPDESK_EMAIL_CATEGORY=General
HELPDESK_SUBJECT_PREFIX=PS

# Reply to a ticket closed within this many days reopens it; 0 = always.
HELPDESK_REOPEN_WINDOW_DAYS=30

# Max tickets one sender may open per hour before overflow is appended.
HELPDESK_SENDER_RATE_LIMIT=20

# Attachments MUST live on a private disk — they are served through a gated
# controller, never a public URL.
HELPDESK_ATTACHMENT_DISK=local
HELPDESK_ATTACHMENT_MAX_BYTES=10485760

# Comma-separated addresses that must never open a ticket.
HELPDESK_BLOCKED_SENDERS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
