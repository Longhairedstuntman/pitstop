# Production environment for Railway.
# Copy these into the Railway service's Variables tab - do NOT commit real values.
# See docs/operations/deployment-railway.md for the full runbook.

APP_NAME=Pitstop
APP_ENV=production
APP_DEBUG=false
APP_KEY=                      # php artisan key:generate --show
APP_URL=https://helpdesk.mwmotor.com

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# --- Database -------------------------------------------------------------
# Railway Postgres plugin supplies these; reference them, don't retype them.
DB_CONNECTION=pgsql
DB_HOST=${{Postgres.PGHOST}}
DB_PORT=${{Postgres.PGPORT}}
DB_DATABASE=${{Postgres.PGDATABASE}}
DB_USERNAME=${{Postgres.PGUSER}}
DB_PASSWORD=${{Postgres.PGPASSWORD}}

# --- Queue / cache / session ---------------------------------------------
# The queue MUST NOT be 'sync': inbound mail is processed by the worker.
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true

# --- Outbound mail (Postmark SMTP) ---------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.postmarkapp.com
MAIL_PORT=587
MAIL_USERNAME=               # Postmark Server API token
MAIL_PASSWORD=               # same token
MAIL_FROM_ADDRESS=helpdesk@mwmotor.com
MAIL_FROM_NAME="MWM Help Desk"

# --- Help desk ------------------------------------------------------------
HELPDESK_INBOUND_ADDRESS=helpdesk@mwmotor.com
HELPDESK_FROM_NAME="MWM Help Desk"

# Long random string. The inbound webhook URL embeds it and the endpoint
# returns 503 without it. Generate: php -r "echo bin2hex(random_bytes(32));"
HELPDESK_INBOUND_SECRET=

HELPDESK_OPS_NOTIFY_EMAIL=
HELPDESK_AUTO_ACK=true
HELPDESK_EMAIL_CATEGORY=General
HELPDESK_EMAIL_PRIORITY=Normal
HELPDESK_SUBJECT_PREFIX=PS
HELPDESK_REOPEN_WINDOW_DAYS=30
HELPDESK_SENDER_RATE_LIMIT=20

# Attachments live on the Railway volume mounted at
# /var/www/html/storage - keep this as 'local' (a PRIVATE disk).
HELPDESK_ATTACHMENT_DISK=local
HELPDESK_ATTACHMENT_MAX_BYTES=10485760
HELPDESK_BLOCKED_SENDERS=

# Who may register an account.
ALLOWED_SIGNUP_DOMAINS=mwmotor.com
